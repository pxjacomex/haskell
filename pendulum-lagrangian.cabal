cabal-version:   2.4
name:            pendulum-lagrangian
version:         0.1.0.0
synopsis:        Symbolic Lagrangian mechanics – pendulum demo
description:
  Port of the scmutils pendulum demo to Haskell.
  Derives the Euler-Lagrange equations symbolically
  using a self-contained computer algebra engine
  (no external dependencies beyond base).
license:         MIT
build-type:      Simple

executable pendulum-demo
  default-language: Haskell2010
  hs-source-dirs:   app, src
  main-is:          Main.hs
  other-modules:
    Symbolic.Expr
    Symbolic.Differentiation
    Symbolic.Simplify
    Mechanics.Lagrangian
  build-depends:
    base >= 4.14 && < 5
  ghc-options: -Wall

executable double-pendulum-demo
  default-language: Haskell2010
  hs-source-dirs:   app, src
  main-is:          DoublePendulum.hs
  other-modules:
    Symbolic.Expr
    Symbolic.Differentiation
    Symbolic.Simplify
    Mechanics.Lagrangian
    Mechanics.Hamiltonian
  build-depends:
    base >= 4.14 && < 5
  ghc-options: -Wall

executable test-symbolic
  default-language: Haskell2010
  hs-source-dirs:   app, src
  main-is:          TestSymbolic.hs
  other-modules:
    Symbolic.Expr
    Symbolic.Differentiation
    Symbolic.Simplify
    Mechanics.Lagrangian
  build-depends:
    base >= 4.14 && < 5
  ghc-options: -Wall
